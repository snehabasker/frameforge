# Checks kept intentionally scoped: correctness/bugprone/performance/modernize
# core set, minus a few modernize checks that fight RAII wrapper style used
# for the ONNX Runtime C API handles.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-cstyle-cast,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length
WarningsAsErrors: ''
HeaderFilterRegex: 'engine/include/.*'
FormatStyle: file
